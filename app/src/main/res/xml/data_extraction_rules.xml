<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="veyra.db" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="veyra.db" />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="instances/" />
        <exclude domain="file" path="instances/*/logs/" />
        <exclude domain="file" path="caches/" />
    </device-transfer>
</data-extraction-rules>